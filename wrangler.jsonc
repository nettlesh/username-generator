{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "username-generator",
  "compatibility_date": "2026-10-06",
  // Without a trailing slash, the route also matches /username-generator, which static assets
  // redirect to /username-generator/.
  "routes": [
    { "pattern": "sebastianbattle.com/username-generator*", "zone_name": "sebastianbattle.com" },
  ],
  "assets": { "directory": "dist" },
  // Each branch build publishes a Preview with `wrangler preview`, which needs this block. It's
  // empty as a site of static assets needs no settings apart from production's. Its URL is on
  // workers.dev, which the route above turns off for production, so Preview URLs are turned on
  // apart from it; they're public.
  "preview_urls": true,
  "previews": {},
}
